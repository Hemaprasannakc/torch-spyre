+++ b/torch_spyre/_inductor/config.py
@@ -98,6 +98,18 @@ def pool_allocated_by_frontend() -> bool:
 # lowering does not yet support (grouped/transposed/non-fp16).
 conv2d_direct_lowering: bool = os.environ.get("SPYRE_CONV2D_DIRECT", "0") == "1"
 
+# How pivot_unaligned_stick_reshapes repairs a reshape that splits/merges the
+# stick dim off a stick boundary (W=160 rows of 2.5 sticks, #1353). On (the
+# default): an on-device stick pivot (two restickifies + a rebase copy per
+# reshape). Off: spyre.reshape_via_cpu, a host round trip. In interleaved
+# measurements (host transfers included, 0.1-13 MB tensors) the pivot took
+# about half the time of the host round trip (e.g. 8.3 ms vs 16.2 ms at
+# 3.3 MB). The pass still uses the host path when no dim can pivot, the dtype
+# is not fp16, or the pivot would exceed the per-core span limit.
+stick_reshape_on_device: bool = (
+    os.environ.get("SPYRE_STICK_RESHAPE_ON_DEVICE", "1") == "1"
+)
+
 # Extend the phase-2 matmul perf reorder (NDO) to the matmul's own output
 # buffer in addition to its input buffers. Off by default until the
 # interaction with downstream span limits is fully validated.
diff --git a/torch_spyre/_inductor/customops.py b/torch_spyre/_inductor/customops.py
index c62b762c..4c4b1c21 100644
--- a/torch_spyre/_inductor/customops.py
+++ b/torch_spyre/_inductor/customops.py
@@ -522,6 +522,23 @@ def restickify(  # type: ignore[empty-body]
     pass
 
 
+@torch.library.custom_op("spyre::rebase_copy", mutates_args=(), device_types="spyre")
+def rebase_copy(x: torch.Tensor) -> torch.Tensor:
+    """Materialize a view of ``x`` as a fresh dense buffer, keeping its stick.
+
+    Unlike restickify (which copies the base buffer), this reads *through* the
+    view, so a split or merge of non-stick dims becomes a separate dense
+    buffer. Used by the stick pivot (stick_reshape_pivot.py) so the following
+    restickify sees separate, dense dims instead of a flattened coordinate.
+    """
+    return x.contiguous().clone()
+
+
+@rebase_copy.register_fake
+def _(x: torch.Tensor) -> torch.Tensor:
+    return torch.empty_like(x, memory_format=torch.contiguous_format)
+
+
 @torch.library.custom_op("spyre::max_dim_int64_fallback", mutates_args=())
 def max_dim_int64_fallback(
     input: torch.Tensor, dim: int, keepdim: bool = False
diff --git a/torch_spyre/_inductor/lowering.py b/torch_spyre/_inductor/lowering.py
index 3d4c7e0e..32e66103 100644
--- a/torch_spyre/_inductor/lowering.py
+++ b/torch_spyre/_inductor/lowering.py
@@ -1694,6 +1694,24 @@ def lower_restickify(x):
     return pw
 
 
+@register_spyre_lowering(torch.ops.spyre.rebase_copy)
+def lower_rebase_copy(x):
+    # Read through x's view (not its base, unlike restickify) into a new,
+    # realized buffer of x's logical shape: an explicit same-stick copy that
+    # Inductor cannot inline back into the consumer.
+    loader = x.make_loader()
+    pw = Pointwise.create(
+        device=x.get_device(),
+        dtype=x.get_dtype(),
+        inner_fn=loader,
+        ranges=x.get_size(),
+        origin_node=V.get_current_node(),
+        traceback=x.get_traceback(),
+    )
+    pw.realize()
+    return pw
+
+
 @register_spyre_lowering(
     torch.ops.spyre.tile_dim_marker,
     type_promotion_kind=None,
